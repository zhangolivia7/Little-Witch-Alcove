{
    "manifest_version": 3,
    "name": "Little Witch Alcove",
    "version": "1.0",
    "description": "A cozy witch-themed focus buddy!",
    "action": {
      "default_popup": "popup.html",
      "default_icon": {
        "16": "Assets/Witch 16.png",
        "32": "Assets/Witch 32.png",
        "48": "Assets/Witch 48.png",
        "128": "Assets/Witch 128.png"
      }
    },
    "permissions": [
      "storage",
      "activeTab"
    ],
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"],
        "run_at": "document_idle"
      }
    ],
    "web_accessible_resources": [
      {
        "resources": [
          "Assets/Witch/Witch Idle.png",
          "Assets/Witch/Witch Flying.png",
          "Assets/Customization/Hat 1.png",
          "Assets/Customization/Hat 2.png",
          "Assets/Customization/Hat 3.png",
          "Assets/Customization/Hat 4.png",
          "Assets/Customization/Robe 1.png",
          "Assets/Customization/Robe 2.png",
          "Assets/Customization/Robe 3.png",
          "Assets/Customization/Robe 4.png"
        ],
        "matches": ["<all_urls>"]
      }
    ]
  }
  